APP_ENV=local
APP_URL=http://localhost/analyticspro
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=analyticspro
DB_USER=root
DB_PASS=
# PostGIS variables are no longer needed. Cadastral geometry is stored in
# dedicated MySQL tables (see sql/cadastral_geometry.sql).
# POSTGIS_HOST=
# POSTGIS_PORT=5432
# POSTGIS_DB=analytics_gis
# POSTGIS_USER=postgres
# POSTGIS_PASS=
APP_BOOTSTRAP_ENCRYPTION_KEY=change-this-32-char-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURITY=tls
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=AnalyticsPRO

# -------------------------------------------------------------------------
# Zornade API — geolocalizzazione particelle catastali
# Registrati su https://app.zornade.com e genera il tuo token API personale.
# Aggiungi il tuo token reale nel file .env locale (MAI nel repository).
# Se lasciato vuoto il sistema usa automaticamente il fallback WFS pubblico AdE.
# -------------------------------------------------------------------------
ZORNADE_API_KEY=
ZORNADE_API_BASE_URL=https://app.zornade.com/api
