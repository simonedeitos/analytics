APP_BOOTSTRAP_ENCRYPTION_KEY=change-this-32-char-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURITY=tls
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=AnalyticsPRO
